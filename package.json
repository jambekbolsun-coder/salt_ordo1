{
  "name": "salt-ordo-system",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:full": "node --env-file=.env.production --env-file=.env.local scripts/dev-server.mjs",
    "seo:prepare": "node scripts/generate-seo.mjs prepare",
    "seo:render": "node scripts/generate-seo.mjs render",
    "build": "npm run seo:prepare && vite build && npm run seo:render",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs",
    "test:sql": "node --test tests/crm-database.test.mjs tests/hardening-database.test.mjs",
    "test:load": "node scripts/benchmark.mjs",
    "test:secrets": "node scripts/scan-secrets.mjs",
    "dev:isolated": "node scripts/isolated-server.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@supabase/supabase-js": "2.57.4",
    "gsap": "^3.15.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "^9.16.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.16.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.13.0",
    "vite": "^6.0.3"
  }
}
