# Public build configuration (safe in browser):
VITE_SALT_SUPABASE_URL=
VITE_SALT_SUPABASE_PUBLISHABLE_KEY=
VITE_PUBLIC_SITE_URL=https://salt-ordo1.vercel.app
# Server only. Store in Vercel Production or gitignored .env.local.
SALT_SUPABASE_URL=
SALT_SUPABASE_PUBLISHABLE_KEY=
SALT_GATEWAY_SECRET=
# 32 random bytes, base64 encoded:
SALT_SESSION_KEY=
SALT_APP_ORIGIN=https://salt-ordo1.vercel.app

# Optional analytics. Public IDs returned by tracking-config; scripts require consent.
SALT_GA4_MEASUREMENT_ID=
SALT_META_PIXEL_ID=
# Server-only Meta credentials; use the version shown in Meta's API setup.
SALT_META_ACCESS_TOKEN=
SALT_META_API_VERSION=
# Optional during Meta Test Events only; remove after verification.
SALT_META_TEST_EVENT_CODE=
# Optional private HTTPS monitoring receiver; receives sanitized structured errors only.
SALT_MONITORING_WEBHOOK_URL=
SALT_MONITORING_WEBHOOK_TOKEN=
